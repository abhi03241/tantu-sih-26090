# TANTU - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Backend Persistence
DATABASE_URL=sqlite:///./tantu.db

# AI Integration Mode (CRITICAL FOR DEMO)
# Set to 'true' for fallback/mock AI responses (guarantees 100% demo uptime without external API keys)
# Set to 'false' if external AI APIs (OpenAI/Gemini/HuggingFace) are configured by team members M, R, S
MOCK_AI=true

# External AI Provider Credentials (Optional / Future Integration)
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=
