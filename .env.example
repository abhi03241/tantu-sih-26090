# ShilpVani - Backend Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Backend Persistence
DATABASE_PATH=backend/tantu.db
# For Render with a persistent disk mounted at /var/data:
# DATABASE_PATH=/var/data/tantu.db
# UPLOADS_DIR=/var/data/uploads
# ENHANCED_IMAGES_DIR=/var/data/enhanced

# AI Integration Mode (CRITICAL FOR DEMO)
# Set to 'true' for fallback/mock AI responses (guarantees 100% demo uptime without external API keys)
# Set to 'false' if external AI APIs (OpenAI/Gemini/HuggingFace) are configured
MOCK_AI=true

# CORS Configuration (Comma-separated allowed frontend origins)
# Leave unset or '*' for prototype demo; or set to your Vercel frontend URL:
CORS_ORIGINS=<YOUR_VERCEL_URL>

# External AI Provider Credentials (Optional / Future Production Integration)
OPENAI_API_KEY=
GEMINI_API_KEY=
REPLICATE_API_KEY=
